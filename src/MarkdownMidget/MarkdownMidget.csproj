<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\midget.ico</ApplicationIcon>
    <!-- MMEEEE: the Epics & Epochs Encyclopedia Editor, a fork of Markdown Midget.
         Its own exe name (and AppIdentity.cs) keep it from colliding with an
         installed Markdown Midget. The project, folder and namespace keep the
         upstream name so upstream changes still merge. -->
    <AssemblyName>MMEEEE</AssemblyName>
    <RootNamespace>MarkdownMidget</RootNamespace>
    <AssemblyTitle>MMEEEE</AssemblyTitle>
    <Product>MMEEEE - Epics and Epochs Encyclopedia Editor</Product>
    <Company>RenegadeMinds</Company>
    <Authors>RenegadeMinds; Funcular Labs</Authors>
    <Copyright>Based on Markdown Midget, copyright © Funcular Labs 2026. Licensed under the MIT License.</Copyright>
    <Description>Markdown editor for the Epics &amp; Epochs rulebooks: tabs, a project explorer and Word / ODT / HTML / PDF builds, on top of Markdown Midget.</Description>
    <!-- What a local build reports; CI derives both from the git tag at release time.
         1.1.0 = this fork's first version, built on Markdown Midget 1.0.3. -->
    <Version>1.1.0</Version>
    <InformationalVersion>1.1.0</InformationalVersion>
    <!-- Don't append the +git-sha suffix to InformationalVersion — it clutters the
         file-properties dialog and doesn't help users. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Every local build of THIS project takes the next number from the clone's own
       counter and stamps it into the file version (1.0.3.57) and the product
       version (1.0.3+build.57), so a published exe can be told apart from the
       one it replaced. Nothing happens on CI: a released exe reports the tag, as
       before. See build/LocalBuildNumber.targets and README, "Build & run". -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\LocalBuildNumber.targets" />

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <!-- The source view (Ctrl+E) is an AvalonEdit editor, wrapped by Source\SourceEditor.cs
         so the rest of the app keeps talking to a TextBox-shaped surface. MIT; the net8
         asset resolves cleanly on net10 (verified in docs/plans/source-view-editor.md). -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MarkdownMidget.Tests" />
  </ItemGroup>

  <!-- App icon + mascot images shown in the title bar, taskbar and toolbar. -->
  <ItemGroup>
    <Resource Include="Assets\midget-64.png" />
    <Resource Include="Assets\midget-256.png" />
    <Resource Include="Assets\numbered-list-64.png" />
    <Resource Include="Assets\spellcheck-64.png" />
    <!-- The same two toolbar pictures with the near-black ink made light, for the dark
         chrome palette (Chrome\ChromeDark.xaml); colours other than the ink are unchanged. -->
    <Resource Include="Assets\numbered-list-64-dark.png" />
    <Resource Include="Assets\spellcheck-64-dark.png" />
  </ItemGroup>

  <!-- The Milkdown editor bundle (built by editor-src) is embedded in the assembly
       and extracted at runtime. This keeps a self-contained single-file publish to
       one actual file instead of an exe plus a loose wwwroot folder. -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\index.html;wwwroot\editor.bundle.js;wwwroot\editor.bundle.css">
      <LogicalName>wwwroot/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- User help, shown read-only via the Help menu. -->
    <EmbeddedResource Include="..\..\HELP.md">
      <LogicalName>HELP.md</LogicalName>
    </EmbeddedResource>
    <!-- Release notes, shown read-only via Help ▸ What's New and the mascot. Newest
         entry first, per Keep a Changelog — the viewer doesn't reorder anything. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md">
      <LogicalName>CHANGELOG.md</LogicalName>
    </EmbeddedResource>
    <!-- The guide the file-dialog crash notice opens in the browser (Picker\PickerCrashDialog):
         HTML, so a broken file dialog can't stand between the user and reading it. -->
    <EmbeddedResource Include="Picker\file-dialog-crashes.html">
      <LogicalName>file-dialog-crashes.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Themes. The built-ins are extracted to the themes folder on launch and
       overwritten when the version moves, so an update delivers fixes to them;
       the sample is copied into themes\custom\ once and then left alone. The
       logical names are what ThemeStore matches on, so the "themes/" prefix and
       the flat shape are load-bearing, not decoration. -->
  <ItemGroup>
    <EmbeddedResource Include="Themes\builtin\*.css">
      <LogicalName>themes/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Themes\sample.css">
      <LogicalName>themes-sample.css</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- MMEEEE: scripts the app hands to other programs (Tabs\AppScripts.cs writes them
       out to %LOCALAPPDATA%\EEEE\scripts when used). Tabs\scripts\converter is the
       Word -> Markdown converter: kept with the source, not part of the app. -->
  <ItemGroup>
    <EmbeddedResource Include="Tabs\scripts\html_bits.lua">
      <LogicalName>scripts/html_bits.lua</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Markdown syntax highlighting for the source view, loaded by SourceHighlighting.
       Named colours only; the theme sets the brushes at runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="Themes\Markdown.xshd">
      <LogicalName>Markdown.xshd</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>

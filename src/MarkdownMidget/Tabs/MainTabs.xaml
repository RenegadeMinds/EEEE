<Window x:Class="MarkdownMidget.Tabs.MainTabs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:MarkdownMidget.Tabs"
        Title="MMEEEE" Width="1280" Height="820" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Chrome.Window.Background}" Foreground="{DynamicResource Chrome.Text}"
        FontFamily="Segoe UI" FontSize="13">
    <!-- The tabbed window: global toolbar on top, explorer panes on the left,
         document tabs on the right. Skeleton - documents are plain text views
         until the editor control replaces them. -->
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- Colours come from the app's chrome palette, so light/dark follows the editor's setting. -->

        <!-- Flat toolbar button: icon + label -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Chrome.Button.Hover.Background}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square close button on a tab -->
        <Style x:Key="TabClose" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="ToolTip" Value="Close"/>
        </Style>

        <!-- Document tabs: flat, accent underline on the selected one -->
        <Style x:Key="DocTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Chrome.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="12,7,6,7" Margin="0,0,1,0" Background="Transparent"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Chrome.Button.Hover.Background}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Chrome.Menu.Background}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Chrome.Text.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right-click menu for a document tab. x:Shared="False" gives every tab its own
             copy, so each menu's DataContext is that tab's DocumentTab (the handlers in
             MainTabs.Menus.cs read it from the MenuItem). -->
        <ContextMenu x:Key="TabMenu" x:Shared="False">
            <MenuItem Header="Close" Click="TabMenu_Close" InputGestureText="Ctrl+W"/>
            <MenuItem Header="Close Others" Click="TabMenu_CloseOthers"/>
            <MenuItem Header="Close to the Right" Click="TabMenu_CloseToRight"/>
            <MenuItem Header="Close All" Click="TabMenu_CloseAll"/>
            <Separator/>
            <MenuItem Header="Build" ToolTip="Builds the file as saved on disk" SubmenuOpened="BuildMenu_SubmenuOpened">
                <MenuItem Header="Open Document (ODT)" Tag="odt" Click="Build_Click"/>
                <MenuItem Header="Web page (HTML)" Tag="html" Click="Build_Click"/>
                <MenuItem Header="MicroShit Word (DOCX)" Tag="docx" Click="Build_Click"/>
                <MenuItem Header="Barfed up dogshit (PDF)" Tag="pdf" Click="Build_Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Copy Path" Click="TabMenu_CopyPath"/>
            <MenuItem Header="Show in Explorer" Click="TabMenu_ShowInExplorer"/>
        </ContextMenu>

        <!-- Right-click menus for the Files and Project trees. Same idea as TabMenu:
             each MenuItem's DataContext is the FileTreeItem / ProjectItem clicked on.
             TreeItemWithMenu picks FolderMenu or FileMenu from the item's IsFolder. -->
        <ContextMenu x:Key="FolderMenu" x:Shared="False" Opened="FolderMenu_Opened">
            <MenuItem Header="Concatenate into New File…" Click="TreeMenu_Concat"/>
            <!-- Headers and counts are filled in by FolderMenu_Opened -->
            <MenuItem Header="Open All">
                <MenuItem Header="…in this folder" Tag="here" Click="TreeMenu_OpenAll"/>
                <MenuItem Header="…and all subfolders" Tag="all" Click="TreeMenu_OpenAll"/>
            </MenuItem>
            <MenuItem Header="New Entry…" Click="TreeMenu_NewEntry"/>
            <MenuItem Header="Build" SubmenuOpened="BuildMenu_SubmenuOpened">
                <MenuItem Header="Open Document (ODT)" Tag="odt" Click="Build_Click"/>
                <MenuItem Header="Web page (HTML)" Tag="html" Click="Build_Click"/>
                <MenuItem Header="MicroShit Word (DOCX)" Tag="docx" Click="Build_Click"/>
                <MenuItem Header="Barfed up dogshit (PDF)" Tag="pdf" Click="Build_Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Open in Explorer" Click="TreeMenu_ShowInExplorer"/>
            <MenuItem Header="Copy Full Path" Click="TreeMenu_CopyPath"/>
        </ContextMenu>
        <ContextMenu x:Key="FileMenu" x:Shared="False">
            <MenuItem Header="Open" Click="TreeMenu_Open"/>
            <MenuItem Header="New Entry…" Click="TreeMenu_NewEntry"
                      ToolTip="A new file right after this one, numbered between it and the next"/>
            <MenuItem Header="Build" SubmenuOpened="BuildMenu_SubmenuOpened">
                <MenuItem Header="Open Document (ODT)" Tag="odt" Click="Build_Click"/>
                <MenuItem Header="Web page (HTML)" Tag="html" Click="Build_Click"/>
                <MenuItem Header="MicroShit Word (DOCX)" Tag="docx" Click="Build_Click"/>
                <MenuItem Header="Barfed up dogshit (PDF)" Tag="pdf" Click="Build_Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Show in Explorer" Click="TreeMenu_ShowInExplorer"/>
            <MenuItem Header="Copy Full Path" Click="TreeMenu_CopyPath"/>
            <MenuItem Header="Copy Markdown Link" Click="TreeMenu_CopyLink"
                      ToolTip="A [heading](path) link to this file, relative to the document in the current tab"/>
        </ContextMenu>
        <Style x:Key="TreeItemWithMenu" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="2,3"/>
            <Setter Property="ContextMenu" Value="{StaticResource FileMenu}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter Property="ContextMenu" Value="{StaticResource FolderMenu}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Document tabs carry the document's name for screen readers / UI automation -->
        <Style x:Key="DocTabItemNamed" TargetType="TabItem" BasedOn="{StaticResource DocTabItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            <Setter Property="ContextMenu" Value="{StaticResource TabMenu}"/>
        </Style>

        <!-- Left pane tabs (Files, later Project): same look, smaller -->
        <Style x:Key="PaneTabItem" TargetType="TabItem" BasedOn="{StaticResource DocTabItem}"/>
    </Window.Resources>

    <DockPanel>
        <!-- Global toolbar: actions for the whole workspace, not one document -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Chrome.ToolBar.Background}" BorderBrush="{DynamicResource Chrome.ToolBar.Separator}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="6,4">
                <Button Style="{StaticResource ToolButton}" Click="OpenFolder_Click" ToolTip="Show a folder in the Files pane">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE838;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Open Folder"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="OpenFile_Click" ToolTip="Open a Markdown file in a new tab">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8E5;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Open File"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="NewFile_Click" ToolTip="A new blank document in a new tab">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE710;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="New"/>
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Margin="6,4" Fill="{DynamicResource Chrome.ToolBar.Separator}"/>
                <Button Style="{StaticResource ToolButton}" Click="OpenProject_Click"
                        ToolTip="Open a book folder (one with a 000000-index.md) in the Project pane, in book order">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8F1;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Open Project"/>
                    </StackPanel>
                </Button>
                <!-- Project tools: run EEE\_tools scripts on the open project -->
                <Button x:Name="CheckLinksButton" Style="{StaticResource ToolButton}" Click="CheckLinks_Click" IsEnabled="False"
                        ToolTip="Check every link in the project (EEE\_tools\check_links.py)" ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE71B;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Check Links"/>
                    </StackPanel>
                </Button>
                <!-- Build: a drop-down. Clicking opens its menu (BuildButton_Click). -->
                <Button x:Name="BuildButton" Style="{StaticResource ToolButton}" Click="BuildButton_Click" IsEnabled="False"
                        ToolTipService.ShowOnDisabled="True">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open Document (ODT)" Tag="odt" Click="BuildProject_Click"/>
                            <MenuItem Header="Web page (HTML)" Tag="html" Click="BuildProject_Click"/>
                            <MenuItem Header="MicroShit Word (DOCX)" Tag="docx" Click="BuildProject_Click"/>
                            <MenuItem Header="Barfed up dogshit (PDF)" Tag="pdf" Click="BuildProject_Click"/>
                            <Separator/>
                            <MenuItem Header="Contents depth" SubmenuOpened="ContentsDepthMenu_SubmenuOpened"
                                      ToolTip="How many heading levels the contents page lists, for this project">
                                <MenuItem Header="Level 1 only" Tag="1" Click="ContentsDepth_Click"/>
                                <MenuItem Header="Headings 1–2" Tag="2" Click="ContentsDepth_Click"/>
                                <MenuItem Header="Headings 1–3" Tag="3" Click="ContentsDepth_Click"/>
                                <MenuItem Header="Headings 1–4" Tag="4" Click="ContentsDepth_Click"/>
                                <MenuItem Header="Headings 1–5" Tag="5" Click="ContentsDepth_Click"/>
                                <MenuItem Header="Headings 1–6" Tag="6" Click="ContentsDepth_Click"/>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8A5;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Build"/>
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE70D;" FontSize="10" VerticalAlignment="Center" Margin="6,1,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Status line -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Chrome.StatusBar.Background}" BorderBrush="{DynamicResource Chrome.ToolBar.Separator}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Margin="10,3" Foreground="{DynamicResource Chrome.Text.Secondary}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Output of the project tools; hidden until one runs. Double-click a line
             that names a file to open it. -->
        <Border x:Name="OutputPanel" DockPanel.Dock="Bottom" Height="190" Visibility="Collapsed"
                Background="{DynamicResource Chrome.Window.Background}"
                BorderBrush="{DynamicResource Chrome.ToolBar.Separator}" BorderThickness="0,1,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,4,4,2">
                    <Button DockPanel.Dock="Right" Style="{StaticResource TabClose}" Content="&#xE711;" Click="CloseOutput_Click"/>
                    <TextBlock x:Name="OutputTitle" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="OutputList" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource Chrome.Text}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         MouseDoubleClick="OutputList_MouseDoubleClick"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left: explorer panes. Only Files for now; Project goes next to it. -->
            <TabControl x:Name="LeftPanes" Grid.Column="0" BorderThickness="0" Background="Transparent" Padding="0">
                <TabItem Style="{StaticResource PaneTabItem}">
                    <TabItem.Header>
                        <TextBlock Text="Files"/>
                    </TabItem.Header>
                    <DockPanel>
                        <TextBlock x:Name="RootLabel" DockPanel.Dock="Top" Margin="10,8,10,4" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TreeView x:Name="FileTree" BorderThickness="0" Background="Transparent" Padding="4,0"
                                  Foreground="{DynamicResource Chrome.Text}"
                                  SelectedItemChanged="FileTree_SelectedItemChanged" KeyDown="FileTree_KeyDown"
                                  ItemContainerStyle="{StaticResource TreeItemWithMenu}">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type tabs:FileTreeItem}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="{Binding Glyph}" Margin="0,0,6,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Chrome.Text.Secondary}"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </TabItem>

                <!-- Project: a book folder in book order, from its 000000-index.md files -->
                <TabItem x:Name="ProjectPane" Style="{StaticResource PaneTabItem}">
                    <TabItem.Header>
                        <TextBlock Text="Project"/>
                    </TabItem.Header>
                    <Grid>
                        <TextBlock x:Name="ProjectHint" Margin="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Chrome.Text.Secondary}"
                                   Text="Open Project shows a book folder (one with a 000000-index.md) here, in book order."/>
                        <TreeView x:Name="ProjectTree" BorderThickness="0" Background="Transparent" Padding="4,6,4,0"
                                  Foreground="{DynamicResource Chrome.Text}"
                                  SelectedItemChanged="ProjectTree_SelectedItemChanged" KeyDown="ProjectTree_KeyDown"
                                  MouseDoubleClick="ProjectTree_MouseDoubleClick"
                                  ItemContainerStyle="{StaticResource TreeItemWithMenu}">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type tabs:ProjectItem}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="{Binding Glyph}" Margin="0,0,6,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Chrome.Text.Secondary}"/>
                                        <TextBlock Text="{Binding Label}"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Chrome.ToolBar.Separator}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Right: tab strip (headers only) over a stack of document views.
                 Every view stays loaded; only the selected one is visible. -->
            <DockPanel Grid.Column="2">
                <TabControl x:Name="DocTabs" DockPanel.Dock="Top" BorderThickness="0" Background="Transparent"
                            Padding="0" ItemContainerStyle="{StaticResource DocTabItemNamed}"
                            SelectionChanged="DocTabs_SelectionChanged">
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type tabs:DocumentTab}">
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource TabClose}" Content="&#xE711;" Click="CloseTab_Click" Tag="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <!-- No content here: the views live in DocHost below. -->
                    <TabControl.ContentTemplate>
                        <DataTemplate/>
                    </TabControl.ContentTemplate>
                </TabControl>
                <Grid x:Name="DocHost" Background="{DynamicResource Chrome.Window.Background}">
                    <TextBlock x:Name="EmptyHint" Text="Pick a Markdown file on the left, Open File, or New."
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Chrome.Text.Secondary}"/>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
